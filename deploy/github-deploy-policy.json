{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PushTheImage",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:CompleteLayerUpload",
        "ecr:InitiateLayerUpload",
        "ecr:PutImage",
        "ecr:UploadLayerPart",
        "ecr:BatchGetImage",
        "ecr:DescribeImages",
        "ecr:DescribeRepositories",
        "ecr:GetDownloadUrlForLayer"
      ],
      "Resource": "arn:aws:ecr:REPLACE_REGION:REPLACE_ACCOUNT:repository/vedaai-grader"
    },
    {
      "Sid": "GetAnEcrLoginToken",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "RegisterTaskDefinitionsWhichCannotBeScoped",
      "Effect": "Allow",
      "Action": [
        "ecs:RegisterTaskDefinition",
        "ecs:DescribeTaskDefinition"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RollOutOnlyThisService",
      "Effect": "Allow",
      "Action": [
        "ecs:UpdateService",
        "ecs:DescribeServices"
      ],
      "Resource": "arn:aws:ecs:REPLACE_REGION:REPLACE_ACCOUNT:service/vedaai-grader/vedaai-grader"
    },
    {
      "Sid": "ReadOnlyThisClustersTasks",
      "Effect": "Allow",
      "Action": "ecs:DescribeTasks",
      "Resource": "arn:aws:ecs:REPLACE_REGION:REPLACE_ACCOUNT:task/vedaai-grader/*"
    },
    {
      "Sid": "ListTasksInThisClusterOnly",
      "Effect": "Allow",
      "Action": "ecs:ListTasks",
      "Resource": "*",
      "Condition": {
        "ArnEquals": {
          "ecs:cluster": "arn:aws:ecs:REPLACE_REGION:REPLACE_ACCOUNT:cluster/vedaai-grader"
        }
      }
    },
    {
      "Sid": "NameTheTaskRolesInATaskDefinition",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::REPLACE_ACCOUNT:role/vedaai-grader-task",
        "arn:aws:iam::REPLACE_ACCOUNT:role/vedaai-grader-execution"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ReadTheTaskNetworkingToReportTheUrl",
      "Effect": "Allow",
      "Action": "ec2:DescribeNetworkInterfaces",
      "Resource": "*"
    },
    {
      "Sid": "AimTheGatewayAtTheNewTask",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET",
        "apigateway:PATCH"
      ],
      "Resource": "arn:aws:apigateway:REPLACE_REGION::/apis*"
    }
  ]
}
