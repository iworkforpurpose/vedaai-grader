# rendered page images — regenerable, and may contain real student work
.pagestore/

# golden-set fixtures — derived, and partly student work
#
# The synthetic cases rebuild themselves whenever the generator changes, so a
# tracked copy adds binary churn and cannot go stale in a way anyone would notice.
# The adopted real samples are copies of handwritten scripts and rendered pages of
# them, which do not belong in version control at all.
packages/generated/

# design reference exports — large rasters, and the Figma file is the source.
#
# Nested as well as top level. `design/*.png` does not match a subdirectory, and
# a folder of rendered comparison pages went in under `design/highlight-shapes/`
# holding real handwriting from the ASAP corpus — which is licensed for
# non-commercial research and must not be in a repository. Nothing was committed;
# the pattern is widened so nothing can be.
design/*.png
design/**/*.png
design/**/*.jpg
design/**/*.jpeg
apps/web/design/

# tooling scratch
.playwright-mcp/
.pytest_cache/
.ruff_cache/
.mypy_cache/
coverage/
htmlcov/

# eval artifacts — large, regenerable from the case matrix
packages/evals/generated/
packages/evals/reports/

# local sample data (real student work — never commit)
data/
*.local.pdf

# os
.DS_Store

# Rebuilt corpus pages and run results — real student answer scripts.
data/corpus/

# treehouse worktree pool
.treehouse/
treehouse.toml
